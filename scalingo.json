{
  "name": "GestionMagazin",
  "description": "Application de gestion multi-boutiques avec système de ventes et inventaire",
  "addons": [
    "postgresql:postgresql-starter-512",
    "redis:redis-starter-256"
  ],
  "env": {
    "SECRET_KEY": {
      "description": "Clé secrète Django (générer une nouvelle)",
      "generator": "secret"
    },
    "DEBUG": {
      "description": "Mode debug Django (False en production)",
      "value": "False"
    },
    "ALLOWED_HOSTS": {
      "description": "Hôtes autorisés (séparés par des virgules)",
      "value": ".scalingo.io,localhost"
    },
    "DJANGO_SETTINGS_MODULE": {
      "description": "Module de configuration Django",
      "value": "gestion_magazin.settings"
    },
    "BASE_URL": {
      "description": "URL publique de l'application (liens QR/PDF)",
      "value": "https://gestionnumerique.osc-fr1.scalingo.io"
    },
    "SCALINGO_API_URL": {
      "description": "URL de l'API principale Scalingo",
      "value": "https://api.osc-fr1.scalingo.com"
    },
    "SCALINGO_APP": {
      "description": "Nom de l'application Scalingo",
      "value": "gestionnumerique"
    },
    "SCALINGO_DB_API_URL": {
      "description": "URL de l'API Database Scalingo pour la région de l'application",
      "value": "https://db-api.osc-fr1.scalingo.com"
    },
    "SCALINGO_DB_ADDON_ID": {
      "description": "Identifiant de l'addon PostgreSQL à sauvegarder"
    },
    "SCALINGO_API_TOKEN": {
      "description": "Jeton API Scalingo secret, à définir dans les variables d'environnement Scalingo"
    }
  },
  "formation": {
    "web": {
      "amount": 1,
      "size": "S"
    },
    "worker": {
      "amount": 1,
      "size": "S"
    }
  }
}
