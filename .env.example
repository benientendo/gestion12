# Configuration pour développement local
# Copier ce fichier en .env et remplir les valeurs

# Django
SECRET_KEY=votre-cle-secrete-django-tres-longue-et-aleatoire
DEBUG=True

# Base de données (laisser vide pour SQLite en local)
# DATABASE_URL=postgresql://user:password@localhost:5432/gestion_magazin

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.52.224

# URL de base pour API
BASE_URL=http://localhost:8000

# 🔐 Clé API DeepSeek (IA suggestions articles) — générée sur https://platform.deepseek.com
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 🔔 Notifications push FCM (Firebase) — optionnel, désactivé sans compte de service
# 1) Chemin local vers le JSON du compte de service (console Firebase → Comptes de service → Générer une clé privée)
# GOOGLE_APPLICATION_CREDENTIALS=C:\Users\PC\Documents\GestionMagazin\firebase-service-account.json
# 2) OU contenu du JSON (pratique sur Scalingo) :
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

SCALINGO_API_URL=https://api.osc-fr1.scalingo.com
SCALINGO_APP=gestionnumerique
SCALINGO_DB_API_URL=https://db-api.osc-fr1.scalingo.com
SCALINGO_DB_ADDON_ID=
